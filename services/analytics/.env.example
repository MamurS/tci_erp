# services/analytics — local configuration.
# Copy to .env and fill in. NEVER commit the filled-in file.

# --- User provisioning (POST /users …) --------------------------------------
# Required only for the provisioning endpoints; rating/limit/fx work without.
#
# SECURITY: the service-role key bypasses Row Level Security completely. It
# belongs ONLY in this service's environment. It must never appear in the
# frontend (no VITE_ prefix, ever), in the repository, in a browser, or in a
# log line. If it leaks, rotate it in the Supabase dashboard immediately.
#
# Canonical project: tci_erp (ref reunqrpeumokqgarknge).
# Find the key: Supabase dashboard → Project Settings → API → service_role.
SUPABASE_URL=https://reunqrpeumokqgarknge.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Public exposure (Phase 3d) --------------------------------------------
# All optional; the defaults in app/settings.py are what the deployed service
# uses unless overridden. See README.md -> Deployment.
#
# Comma-separated exact origins. The *.tci-erp.pages.dev preview subdomains
# are matched by an anchored regex and do NOT need listing here.
# CORS_ALLOW_ORIGINS=https://tci-erp.pages.dev
# MAX_BODY_BYTES=1000000
# REQUEST_TIMEOUT_SECONDS=30
# PROVISIONING_PER_IP_PER_HOUR=20
# PROVISIONING_PER_CALLER_PER_HOUR=30
# Only set behind a load balancer that rewrites X-Forwarded-For (Render does).
# TRUST_PROXY_HEADERS=true
# LOG_LEVEL=INFO
