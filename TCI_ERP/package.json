{
  "name": "tci-erp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "design:tokens": "node --experimental-strip-types --no-warnings src/design/emit-tokens.ts",
    "guide:build": "npm run guide:shots && npm run guide:content && npm run guide:pdf && npm run guide:check",
    "guide:shots": "node --experimental-strip-types --no-warnings scripts/guide/shots.ts",
    "guide:content": "node --experimental-strip-types --no-warnings scripts/guide/build-content.ts",
    "guide:pdf": "node --experimental-strip-types --no-warnings scripts/guide/pdf.ts",
    "guide:check": "node --experimental-strip-types --no-warnings scripts/guide/build-content.ts --check && node --experimental-strip-types --no-warnings scripts/guide/typecheck-shots.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/arimo": "5.3.0",
    "@fontsource/pt-sans-narrow": "5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query": "^5.106.1",
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-table": "3.33.0",
    "@tiptap/extension-text-align": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "country-flag-icons": "1.6.20",
    "docx": "9.15.2",
    "docxtemplater": "^3.71.1",
    "i18next": "^26.7.2",
    "i18next-browser-languagedetector": "^8.3.0",
    "lucide-react": "1.69.0",
    "pdfjs-dist": "^6.5.438",
    "pizzip": "^3.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
